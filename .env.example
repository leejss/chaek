# Server-only Gemini API key.
GEMINI_API_KEY=

# Static Gemini webhook signing secret. Returned once when the webhook is created.
GEMINI_WEBHOOK_SIGNING_SECRET=

# Bearer secret for the scheduled internal reconciliation endpoint.
AI_RECONCILIATION_SECRET=

# Server-only Google OAuth credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Exact application origin. Use http://localhost:3000 for local development.
AUTH_BASE_URL=

# Server-only Turso database connection.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
